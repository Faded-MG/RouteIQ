# Django Configuration
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=insecure-development-secret-key-replace-in-production-must-be-50-chars
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL)
POSTGRES_DB=fuelroute
POSTGRES_USER=fuelroute
POSTGRES_PASSWORD=fuelroute_dev_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Upstream Services
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com
ENABLE_WEATHER=1

# Application Contact for Outbound User-Agent (Never hardcode personal details)
APP_CONTACT=https://github.com/example/fuelroute

# Rate Limiting & Performance
PLAN_RATE_LIMIT=30/min
GUNICORN_WORKERS=3
LOG_LEVEL=INFO

# Production Deployment & Infrastructure
IMAGE_TAG=v0.1.0
GHCR_OWNER=example
DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com

# Frontend Environment Variables (Build arguments)
VITE_API_BASE_URL=/api/v1
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=© OpenStreetMap contributors
